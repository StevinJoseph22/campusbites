# CampusBites Environment Configuration
# Copy this file to .env and fill in real values — never commit .env itself.

# Next.js Server & Authentication
NODE_ENV=development
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=campusbites_super_secret_auth_token_key_2026

# Supabase PostgreSQL — use the connection pooler URL (port 6543), not the
# direct connection (port 5432), since serverless platforms like Vercel
# generally can't reach the direct connection.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"

# Cashfree Payment Gateway
CASHFREE_APP_ID=""
CASHFREE_SECRET_KEY=""
CASHFREE_MODE="production"
NEXT_PUBLIC_CASHFREE_MODE="production"

# WebSocket Real-Time Server Port
PORT=3000
SOCKET_PORT=4000

# Real SMS Gateway API Key (e.g. Fast2SMS / Twilio) — optional
FAST2SMS_API_KEY=""

# =========================================================================
# REQUIRED FOR REAL EMAIL OTP DELIVERY:
# Configure your SMTP credentials below (e.g. Gmail App Password, Resend, etc.)
# =========================================================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
# =========================================================================

# Resend — transactional email (OTPs, order updates, receipts)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="CampusBites <noreply@yourdomain.com>"
